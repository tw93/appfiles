{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tw93/appfiles/main/appfiles.schema.json",
  "title": "appfiles.json",
  "description": "The files and system entries an app creates outside its package. This schema checks the shape; validate.mjs also checks the path rules in SPEC.md.",
  "type": "object",
  "required": ["spec", "name"],
  "anyOf": [
    { "required": ["macos"] },
    { "required": ["windows"] },
    { "required": ["linux"] }
  ],
  "properties": {
    "$schema": { "type": "string" },
    "spec": { "const": 0 },
    "name": { "type": "string", "minLength": 1 },
    "macos": {
      "allOf": [
        { "$ref": "#/$defs/platform" },
        {
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "registrations": {
              "items": {
                "properties": {
                  "type": { "enum": ["launchd", "login-item", "pkg", "system-extension", "kext"] }
                }
              }
            }
          }
        }
      ]
    },
    "windows": {
      "allOf": [
        { "$ref": "#/$defs/platform" },
        {
          "properties": {
            "id": {
              "oneOf": [
                { "$ref": "#/$defs/id" },
                { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1 }
              ]
            },
            "registrations": {
              "items": {
                "properties": {
                  "type": { "enum": ["registry", "run-value", "service", "scheduled-task", "firewall-rule", "path-entry", "package"] }
                }
              }
            }
          }
        }
      ]
    },
    "linux": {
      "allOf": [
        { "$ref": "#/$defs/platform" },
        {
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "registrations": {
              "items": {
                "properties": {
                  "type": { "enum": ["systemd-unit", "package"] }
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "platform": {
      "type": "object",
      "required": ["id", "paths"],
      "properties": {
        "paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/path" }
        },
        "registrations": {
          "type": "array",
          "items": { "$ref": "#/$defs/registration" }
        }
      }
    },
    "path": {
      "type": "object",
      "required": ["path", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["user", "component", "data", "config", "state", "log", "cache"] },
        "shared_with": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      }
    },
    "registration": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string" },
        "id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
